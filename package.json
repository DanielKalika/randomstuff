{
  "name": "original-cinema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal catalog and Alloha viewing interface for Kinopk.",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --use-env-proxy server.mjs",
    "dev": "node --watch --use-env-proxy server.mjs",
    "test": "node --test test/server.test.mjs",
    "test:browser": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
